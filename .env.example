# --- Database ---------------------------------------------------------------
# Real stack (docker compose up -d):
DATABASE_URL=postgres://verdict:verdict@localhost:5432/verdict
# Test/demo fallback without Docker (in-process Postgres via PGlite):
#   DATABASE_URL=pglite://./.pglite/verdict

# --- Redis (BullMQ) ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally, R2 in prod) -----------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=verdict
S3_SECRET_KEY=verdict-secret
S3_BUCKET=verdict-snapshots

# --- Chain RPC (see docs/DECISIONS.md ADR-0002, ADR-0011) -------------------
# Each value may be a full https:// URL OR a bare API key. A bare key is
# expanded to the provider URL for its slot: primary -> Infura, fallback ->
# Alchemy. To use a different provider in a slot, paste the full URL instead.
# Primary: Infura/MetaMask Developer free tier (create key at developer.metamask.io)
POLYGON_RPC_URL=
ETHEREUM_RPC_URL=
# Secondary (viem fallback transport): Alchemy free tier
POLYGON_RPC_URL_FALLBACK=
ETHEREUM_RPC_URL_FALLBACK=

# --- LLM (unused in Phase 0; packages/llm is a stub) ------------------------
ANTHROPIC_API_KEY=
